@page "/addbook"
@inject NavigationManager NavigationManager
@inject IBookService BookService
@using GestionBibliotheque.Blazor.Models;
@using GestionBibliotheque.Blazor.Services

<h3>Ajouter un livre</h3>
<div class="container mt-2">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <EditForm Model="newBook" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label for="title" class="form-label">Titre</label>
                    <InputText id="title" class="form-control form-control-small" @bind-Value="newBook.Title" />
                    <ValidationMessage For="@(() => newBook.Title)" />
                </div>
                <div class="mb-3">
                    <label for="author" class="form-label">Auteur</label>
                    <InputText id="author" class="form-control form-control-small" @bind-Value="newBook.Author" />
                    <ValidationMessage For="@(() => newBook.Author)" />
                </div>
                <div class="mb-3">
                    <label for="datePub" class="form-label">Date de publication</label>
                    <InputDate id="datePub" class="form-control form-control-small" @bind-Value="newBook.DatePub" />
                    <ValidationMessage For="@(() => newBook.DatePub)" />
                </div>

                <button type="submit" class="btn btn-success">Ajouter</button>
                <button type="button" class="btn btn-secondary" @onclick="GoBack">Retour à la liste</button>

            </EditForm>
        </div>
    </div>
</div>

@code {
    private CreateBookDto newBook = new CreateBookDto();

    private async Task HandleValidSubmit()
    {
        await BookService.CreateBookAsync(newBook);
        NavigationManager.NavigateTo("/books");
    }
    private void GoBack()
    {
        NavigationManager.NavigateTo("/books");
    }
}